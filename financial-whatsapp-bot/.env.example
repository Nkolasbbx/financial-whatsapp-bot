# FinancIAl - WhatsApp Bot
# Copiar como .env y completar. Nunca subir .env al repositorio.

# Selección del webhook: false usa Meta; true habilita el modo Twilio.
DEBUG=false

# WhatsApp Business Platform - Meta Cloud API
WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=EAAB_REEMPLAZAR_CON_TOKEN_PERMANENTE
META_PHONE_NUMBER_ID=123456789012345
META_WABA_ID=123456789012345
META_WEBHOOK_VERIFY_TOKEN=reemplazar_por_un_token_aleatorio_y_secreto
META_APP_SECRET=reemplazar_por_la_clave_secreta_de_la_app
META_GRAPH_API_VERSION=v26.0

# Twilio opcional, utilizado solamente con DEBUG=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Supabase
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_KEY=eyJ_REEMPLAZAR_CON_LA_CLAVE_USADA_POR_LA_APP

# Clave exclusiva del backend para reminder_deliveries y campos protegidos por RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ_REEMPLAZAR_CON_SERVICE_ROLE_KEY

# IA y RAG. No son necesarios para ejecutar los recordatorios.
# Sirve con cualquier proveedor compatible con la API de OpenAI: para cambiar
# de proveedor (Groq, OpenRouter, etc.) o de modelo, solo hace falta
# reemplazar estas 3 variables — no requiere tocar código.
# OLLAMA_URL = la URL base documentada por el proveedor, tal cual (incluye su
# propio prefijo de versión, ej. "/openai/v1" en Groq o "/api/v1" en
# OpenRouter) — el código le agrega "/chat/completions" sin modificarla.
#
# Ejemplo con Groq:
#   OLLAMA_URL=https://api.groq.com/openai/v1
#   OLLAMA_MODEL=llama-3.3-70b-versatile
#   IA_API_KEY=gsk_REEMPLAZAR_CON_API_KEY_DE_GROQ
# 
# Ejemplo con OpenRouter (usar el slug de modelo que figura en
# https://openrouter.ai/models, formato "proveedor/modelo"):
OLLAMA_URL=https://openrouter.ai/api/v1
OLLAMA_MODEL=anthropic/claude-haiku-5.5
IA_API_KEY=sk-or-REEMPLAZAR_CON_API_KEY_DE_OPENROUTER
# Claude Haiku 5.5 razona por defecto en OpenRouter: sin esto suma latencia y
# puede cortar respuestas al gastar max_tokens pensando. Con Ollama u otro
# proveedor que no acepte el parámetro "reasoning", dejarlo en false.
IA_DISABLE_REASONING=true

# Resúmenes de conversación (memoria del asistente) con OpenRouter. También
# los usa la ingesta contextual (INGESTION_ENABLE_CONTEXTUAL=true).
RES_URL=https://openrouter.ai/api/v1
RES_MODEL=openai/gpt-4o-mini
RES_KEY=sk-or-REEMPLAZAR_CON_API_KEY_DE_OPENROUTER
# Cada cuántos mensajes guardados se actualiza el resumen.
RESUMEN_FRECUENCIA_MENSAJES=10

DB_DSN=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@TU_POOLER:6543/postgres
HF_TOKEN=hf_REEMPLAZAR_CON_TOKEN_DE_INFERENCE
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base

# Recordatorios proactivos
# En local puede dejarse false hasta probar; en producción debe ser true.
REMINDERS_ENABLED=false
REMINDER_TEMPLATE_NAME=recordatorio_roadmap
REMINDER_FINAL_TEMPLATE_NAME=last_reminder_roadmap
REMINDER_TEMPLATE_LANGUAGE=es_CL

# Se usa en {{1}} mientras no se almacene el nombre del usuario.
REMINDER_RECIPIENT_LABEL=emprendedor/a

REMINDER_DAYS=3
REMINDER_TIMEZONE=America/Santiago
REMINDER_BATCH_SIZE=50

# Calendario personalizado (HdU08).
# La plantilla debe estar aprobada en Meta, con idioma es_CL y dos variables
# en el cuerpo: {{1}} descripción del compromiso y {{2}} fecha/hora.
CALENDAR_REMINDERS_ENABLED=false
CALENDAR_TEMPLATE_NAME=recordatorio_fecha_personalizada
CALENDAR_TEMPLATE_LANGUAGE=es_CL
CALENDAR_DEFAULT_HOUR=9
CALENDAR_BATCH_SIZE=50

# Convocatorias comunitarias (HdU019).
# ⚠️ PENDIENTE: la plantilla aviso_convocatoria_comunitaria debe estar aprobada
# en Meta antes de activar el envío. Cuerpo con 5 variables: {{1}} municipio,
# {{2}} título, {{3}} categoría, {{4}} fecha/hora y {{5}} lugar o enlace.
COMMUNITY_NOTICES_ENABLED=false
COMMUNITY_TEMPLATE_NAME=aviso_convocatoria_comunitaria
COMMUNITY_TEMPLATE_LANGUAGE=es_CL
COMMUNITY_BATCH_SIZE=100

# Réplica de las convocatorias en Google Calendar (cuenta de servicio).
# GOOGLE_SERVICE_ACCOUNT_JSON lleva el contenido completo del JSON de la clave.
# Cada municipio comparte su calendario con el correo de la cuenta de servicio
# («Hacer cambios en eventos») y pega aquí el ID del calendario.
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
ADMIN_RECOLETA_GOOGLE_CALENDAR_ID=
ADMIN_ELBOSQUE_GOOGLE_CALENDAR_ID=

# Feed .ics de convocatorias (suscripción «Desde URL» en Google Calendar,
# Outlook o Apple). Un secreto largo y aleatorio por cuenta; vacío = sin feed.
ADMIN_RECOLETA_ICS_TOKEN=
ADMIN_ELBOSQUE_ICS_TOKEN=

# Único secreto del cron. Vercel lo envía como Authorization: Bearer <valor>.
CRON_SECRET=reemplazar_por_un_secreto_largo_y_aleatorio

# Límite distribuido de mensajes por teléfono.
# Permite 10 mensajes en una ventana móvil de 60 segundos. El mensaje 11
# activa un bloqueo temporal de 60 segundos.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BLOCK_SECONDS=60

# Registro conversacional de ingresos y gastos (HdU13).
# Usa el mismo proveedor de IA configurado en OLLAMA_URL/OLLAMA_MODEL.
FINANCIAL_MOVEMENTS_ENABLED=true

# Diagnóstico económico HDU017: usa SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY.
# Requiere las tablas y las RPC del diagnóstico en ese Supabase; DB_DSN es del RAG.
# Las tarifas/reglas pendientes producen un resultado parcial, no costos $0.
FORMALIZATION_DIAGNOSTICS_ENABLED=true
# El diagnóstico usa siempre el flujo guiado y selecciona su catálogo en código.

# Cola de arq (worker). En local usa una propia si compartes el Redis con
# otros devs: dos workers en la misma cola se roban los jobs.
# ARQ_QUEUE_NAME=arq:queue:tu-nombre
