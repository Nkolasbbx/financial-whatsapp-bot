# FinancIAl - WhatsApp Bot
# Copiar como .env y completar. Nunca subir .env al repositorio.

# WhatsApp Business Platform - Meta Cloud API
# Proveedor utilizado por el backend. Para esta integración debe ser "meta".
WHATSAPP_PROVIDER=meta

# Token permanente del usuario del sistema con whatsapp_business_messaging.
META_WHATSAPP_TOKEN=EAAB_REEMPLAZAR_CON_TOKEN_PERMANENTE

# Identificador interno del número emisor real; no es el teléfono escrito con +56.
META_PHONE_NUMBER_ID=123456789012345

# Identificador de la cuenta de WhatsApp Business que contiene el número.
META_WABA_ID=123456789012345

# Texto secreto creado por ti y usado también al validar el webhook en Meta.
META_WEBHOOK_VERIFY_TOKEN=reemplazar_por_un_token_aleatorio_y_secreto

# Clave secreta de Financial Chat Bot: Configuración de la app -> Básica.
META_APP_SECRET=reemplazar_por_la_clave_secreta_de_la_app

# Versión de Graph API, con "v" minúscula y sin barra final.
META_GRAPH_API_VERSION=v26.0

# Supabase
# URL del proyecto: Supabase -> Project Settings -> API.
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave API de Supabase utilizada solo por el backend; respeta las políticas RLS.
SUPABASE_KEY=eyJ_REEMPLAZAR_CON_LA_CLAVE_DE_SUPABASE

# Conexión PostgreSQL para RAG. Es opcional si no se utilizará búsqueda RAG.
DB_DSN=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@TU_POOLER:6543/postgres

# IA: Groq Cloud u Ollama compatible con API OpenAI
# Para Groq Cloud, se usa el endpoint y modelo siguientes.
OLLAMA_URL=https://api.groq.com/openai/v1
OLLAMA_MODEL=llama-3.3-70b-versatile

# API key de Groq. Con Ollama local puede dejarse vacía.
IA_API_KEY=gsk_REEMPLAZAR_CON_API_KEY_DE_GROQ

# Alternativa local con Ollama (reemplaza las tres variables anteriores):
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# IA_API_KEY=
