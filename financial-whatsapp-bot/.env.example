# ── Twilio (WhatsApp) ──
# Crear cuenta en https://www.twilio.com/
# El sandbox se activa en: Console → Messaging → Try it out → WhatsApp
# FinancIAl - WhatsApp Bot MVP

# Twilio
TWILIO_ACCOUNT_SID=tokentwlio
TWILIO_AUTH_TOKEN=tu token twilio
TWILIO_WHATSAPP_NUMBER=tuwsp


# ── Supabase (opcional, sin esto usa memoria local) ──
# Crear proyecto en https://supabase.com/
SUPABASE_URL=
SUPABASE_KEY=

# Ollama
OLLAMA_URL=urlllama
OLLAMA_MODEL=urlmodel
IA_API_KEY=key. PD: Si se va a usar el modelo de ngroq poner la llave, en caso de usar el de compañero dejar activo pero vacio.
DB_DSN= string connection
# ── OpenAI ──