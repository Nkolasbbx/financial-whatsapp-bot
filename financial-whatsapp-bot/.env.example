# ── Twilio (WhatsApp) ──
# Crear cuenta en https://www.twilio.com/
# El sandbox se activa en: Console → Messaging → Try it out → WhatsApp
# FinancIAl - WhatsApp Bot MVP
#No se usa
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=


# ── Supabase (opcional, sin esto usa memoria local) ──
# Crear proyecto en https://supabase.com/
SUPABASE_URL= supabase_url
SUPABASE_KEY= supabase_key

# Ollama
OLLAMA_URL= ollama_url
OLLAMA_MODEL= ollama_model
IA_API_KEY= ia_api_key
DB_DSN=stringconecction.

WHATSAPP_PROVIDER = meta
META_WHATSAPP_TOKEN = meta_whatsapp_token
META_PHONE_NUMBER_ID = meta_phone_number_id
META_WABA_ID= meta_waba_id


META_WEBHOOK_VERIFY_TOKEN= meta_webhook_verify_token
META_APP_SECRET = meta_app_secret
META_GRAPH_API_VERSION = v26.0