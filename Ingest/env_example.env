SUPABASE_DSN=stringconecction.

# Contextual Retrieval (opcional; ENABLE_CONTEXTUAL=false lo desactiva).
# Opción local (Ollama, sin rate limit, corre en tu GPU):
CONTEXT_LLM_URL=http://localhost:11434/v1
CONTEXT_LLM_MODEL=qwen2.5:7b
CONTEXT_LLM_API_KEY=ollama
CONTEXT_REASONING_EFFORT=
ENABLE_CONTEXTUAL=true
CONTEXT_MAX_WORKERS=4
CONTEXT_MAX_RETRIES=3
CONTEXT_BATCH_SIZE=2

# Opción nube (Groq): usar un modelo plano, no "compound"/agéntico (esos
# disparan varias llamadas internas por request y agotan el rate limit muy
# rápido). Si el modelo es "razonador" (ej. gpt-oss-*) hay que setear
# CONTEXT_REASONING_EFFORT=low o trunca la respuesta sin emitir nada.
# CONTEXT_LLM_URL=https://api.groq.com/openai/v1
# CONTEXT_LLM_MODEL=openai/gpt-oss-20b
# CONTEXT_LLM_API_KEY=your_groq_api_key
# CONTEXT_REASONING_EFFORT=low
